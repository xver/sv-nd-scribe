{
  "name": "sv-nd-scribe-vscode",
  "displayName": "SV ND Scribe",
  "description": "SV ND Scribe: Real-time NaturalDocs documentation and formatting feedback for SystemVerilog",
  "version": "0.1.0",
  "publisher": "ic-verimeter",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "SystemVerilog NaturalDocs Linter",
      "properties": {
        "sv-nd-scribe.linterPath": {
          "type": "string",
          "default": "/home/v/proj/sv-nd-scribe/linter/linter.py",
          "description": "Path to the linter.py executable python file."
        },
        "sv-nd-scribe.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the python interpreter."
        },
        "sv-nd-scribe.runOn": {
          "type": "string",
          "enum": [
            "onSave",
            "onOpen"
          ],
          "default": "onSave",
          "description": "When to run the linter (onSave or onOpen)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/victo/sv-nd-scribe.git"
  }
}
