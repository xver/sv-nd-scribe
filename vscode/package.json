{
  "name": "sv-nd-scribe-vscode",
  "displayName": "SV ND Scribe",
  "description": "SV ND Scribe: Real-time NaturalDocs documentation and formatting feedback for SystemVerilog",
  "version": "0.1.3",
  "icon": "scribe_logo.jpg",
  "publisher": "ic-verimeter",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sv-nd-scribe.lint",
        "title": "SV_Scribe: Lint"
      },
      {
        "command": "sv-nd-scribe.clear",
        "title": "SV_Scribe: Clear"
      },
      {
        "command": "sv-nd-scribe.lintAll",
        "title": "SV_Scribe: Lint_All"
      },
      {
        "command": "sv-nd-scribe.status",
        "title": "SV_Scribe: Status"
      },
      {
        "command": "sv-nd-scribe.verifyInstallation",
        "title": "SV_Scribe: Verify linter installation"
      }
    ],
    "configuration": {
      "title": "SystemVerilog NaturalDocs Linter",
      "properties": {
        "sv-nd-scribe.linterPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the linter.py executable python file. If empty, falls back to $SVND_SCRIBE_HOME/linter/linter.py."
        },
        "sv-nd-scribe.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the python interpreter."
        },
        "sv-nd-scribe.runOn": {
          "type": "string",
          "enum": [
            "onSave",
            "onOpen"
          ],
          "default": "onSave",
          "description": "When to run the linter (onSave or onOpen)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/victo/sv-nd-scribe.git"
  }
}
